# Copy to .env.local for local development. Never commit real values.

# oauth (default) | demo
AUTH_MODE=oauth

# Database. Leave empty locally to use ./local.db automatically.
# On Vercel these come from the Turso integration (Storage tab).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Sign-in providers. Add at least one. Redirect URL for each:
#   https://YOUR-DOMAIN/auth/<google|discord|twitch>/callback
#   http://localhost:3000/auth/<provider>/callback  (local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: force the public URL used in OAuth redirects (e.g. a custom domain).
# APP_URL=https://creatorarcade.gg
