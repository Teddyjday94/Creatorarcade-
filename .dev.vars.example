# Copy to .dev.vars for local development. Never commit .dev.vars.
# oauth (default) | demo | sites
AUTH_MODE=oauth

# Add at least one provider. For local sign-in, also add
# http://127.0.0.1:5173/auth/<provider>/callback as a redirect URL in that provider's console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: force the public URL used in OAuth redirects (custom domain).
# APP_URL=https://creatorarcade.gg
